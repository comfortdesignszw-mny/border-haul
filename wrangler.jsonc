{
  // Static, assets-only Worker: no server code, it just serves ./public.
  // The name must match the Worker name in your Cloudflare dashboard.
  "name": "border-haul",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "not_found_handling": "single-page-application"
  }
}
